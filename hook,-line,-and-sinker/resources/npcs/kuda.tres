[sub_resource type="Resource" id="Rule_invitation"]
script = ExtResource("2_rule")
json_path = "res://dialogue/kuda_invitation.json"
required_flags = Array[StringName]([&"Recruited", &"barracuda_scarf_complete"])
forbidden_flags = Array[StringName]([&"barracuda_invitation_accepted", &"barracuda_route_complete"])

[sub_resource type="Resource" id="Rule_post_romance"]
script = ExtResource("2_rule")
json_path = "res://dialogue/kuda_post_romance.json"
required_flags = Array[StringName]([&"Recruited", &"barracuda_route_complete"])

[sub_resource type="Resource" id="Rule_casual"]
script = ExtResource("2_rule")
json_path = "res://dialogue/kuda_casual.json"
required_flags = Array[StringName]([&"Recruited"])

[sub_resource type="Resource" id="Rule_retry"]
script = ExtResource("2_rule")
json_path = "res://dialogue/kuda_second_catch.json"
required_flags = Array[StringName]([&"barracuda_met"])
forbidden_flags = Array[StringName]([&"Recruited"])

[sub_resource type="Resource" id="Rule_first"]
script = ExtResource("2_rule")
json_path = "res://dialogue/kuda_first_catch.json"
forbidden_flags = Array[StringName]([&"Recruited"])

[resource]
script = ExtResource("1_npc")
npc_id = &"barracuda"
display_name = "Kuda"
portrait = ExtResource("6_2m545")
underwater_sprite = ExtResource("underwater_kuda")
door = SubResource("Resource_ad8vp")
porn_sprite = ExtResource("7_kuda_scene")
encounter_rules = Array[ExtResource("2_rule")]([SubResource("Rule_invitation"), SubResource("Rule_post_romance"), SubResource("Rule_casual"), SubResource("Rule_retry"), SubResource("Rule_first")])
desired_gift = ExtResource("5_gift")
