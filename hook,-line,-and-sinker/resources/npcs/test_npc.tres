forbidden_flags = Array[StringName]([&"spyglass_hint_heard", &"spyglass_complete"])

[sub_resource type="Resource" id="Resource_w20er"]
script = ExtResource("3_w20er")
json_path = "res://dialogue/garden_eel_casual.json"
