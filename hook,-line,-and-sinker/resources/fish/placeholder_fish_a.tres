[ext_resource type="Script" uid="uid://d2iidpvp5wrw7" path="res://resources/fish_data.gd" id="1_fish"]
[ext_resource type="Resource" uid="uid://dh5u57inonklf" path="res://resources/items/placeholder_fish_a_item.tres" id="2_item"]
[ext_resource type="Script" uid="uid://cur8k0lqp6jxh" path="res://resources/fish_escape_state.gd" id="3_state"]

[sub_resource type="Resource" id="Resource_initial"]
