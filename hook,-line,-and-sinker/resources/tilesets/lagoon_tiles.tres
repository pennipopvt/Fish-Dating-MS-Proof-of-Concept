[gd_resource type="TileSet" format=3]

[resource]
# One grid is used for SOLID walls only; background, detail, and
# foreground PNGs are placed as individual Sprite2D scene children.
# Add a wall/rock atlas source in the Godot TileSet editor when art is ready.
tile_size = Vector2i(16, 16)
# Solid-wall physics is isolated on layer 2 for Penni and the thrown net.
physics_layer_0/collision_layer = 2
physics_layer_0/collision_mask = 0
