[gd_resource type="TileSet" format=3]

[resource]
# Shared atlas grid for every underwater drawing layer.
# Drop your finished PNG into the TileSet editor as an Atlas Source.
tile_size = Vector2i(16, 16)
# Physical walls are on 2D collision layer 2 so the diver's ShapeCast2D
# can ignore overworld physics. Only paint collidable tiles on Solids.
physics_layer_0/collision_layer = 2
physics_layer_0/collision_mask = 0
