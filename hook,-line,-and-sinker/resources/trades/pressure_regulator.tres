[gd_resource type="Resource" script_class="TradeData" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/trade_data.gd" id="trade_script"]
[ext_resource type="Script" path="res://resources/trade_requirement.gd" id="requirement_script"]
[ext_resource type="Resource" path="res://resources/items/mullet.tres" id="preview_mullet"]
[ext_resource type="Texture2D" path="res://sprites/ui/icon_challenges.png" id="preview_icon"]

[sub_resource type="Resource" id="PreviewCost"]
script = ExtResource("requirement_script")
item = ExtResource("preview_mullet")
amount = 1

[resource]
script = ExtResource("trade_script")
trade_id = &"pressure_regulator"
display_name = "Pressure Regulator"
description = "Reduces extra oxygen drain from depth by 25%. Preview price; 1 day delivery."
one_time_purchase = true
icon = ExtResource("preview_icon")
delivery_time = 1
requirements = Array[ExtResource("requirement_script")]([SubResource("PreviewCost")])
reward_method = &"shop_reward_pressure_regulator"
reward_amount = 25
delivery_sprite = ExtResource("preview_icon")
