[gd_resource type="Resource" script_class="TradeData" format=3]

[ext_resource type="Script" path="res://resources/trade_data.gd" id="1_trade"]
[ext_resource type="Script" path="res://resources/trade_requirement.gd" id="2_req"]
[ext_resource type="Resource" path="res://resources/items/easy_test_fish_item.tres" id="3_easy"]
[ext_resource type="Texture2D" path="res://sprites/gifts/gift_statue.png" id="4_icon"]
[ext_resource type="Resource" path="res://resources/items/statue.tres" id="5_gift"]

[sub_resource type="Resource" id="Resource_easy"]
script = ExtResource("2_req")
item = ExtResource("3_easy")
amount = 1

[resource]
script = ExtResource("1_trade")
trade_id = &"statue_gift"
display_name = "Statue"
description = "A small decorative statue to give as a present."
icon = ExtResource("4_icon")
requirements = Array[ExtResource("2_req")]([SubResource("Resource_easy")])
reward_item = ExtResource("5_gift")
